<view class="page-wrap">

  <!-- 总览 -->
  <view class="card stat-card">
    <view class="stat">
      <text class="stat-num">{{days}}</text>
      <text class="stat-label">训练天数</text>
    </view>
    <view class="stat">
      <text class="stat-num">{{count}}</text>
      <text class="stat-label">记录条数</text>
    </view>
    <picker mode="date" bindchange="pickStart">
      <view class="stat stat-tap">
        <text class="stat-num">{{sinceDays}}</text>
        <text class="stat-label">健身已经 · 天</text>
      </view>
    </picker>
  </view>
  <view class="stat-hint">「健身已经」从训练起点算起，点那格可以改起点日。</view>

  <!-- 月历 -->
  <view class="card cal-card">
    <view class="cal-head">
      <text class="cal-title">{{calTitle}}</text>
      <view class="cal-head-actions">
        <button class="btn btn-sm bf-btn {{backfillArmed ? 'btn-danger' : 'btn-soft'}}" bindtap="toggleBackfill">{{backfillArmed ? '取消补记' : '补记录'}}</button>
        <view class="cal-nav">
          <view class="n" data-dir="-1" bindtap="shiftMonth">‹</view>
          <view class="n" data-dir="1" bindtap="shiftMonth">›</view>
        </view>
      </view>
    </view>
    <view class="cal-week">
      <text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text><text>日</text>
    </view>
    <view class="cal-grid">
      <view wx:for="{{calCells}}" wx:key="key" class="cal-cell {{item.empty ? 'blank' : ''}} {{item.hasRecord ? 'has' : ''}} {{item.isToday ? 'today' : ''}} {{item.sel ? 'sel' : ''}} {{item.canFill ? 'can-fill' : ''}} {{item.isTarget ? 'target' : ''}}" data-key="{{item.key}}" bindtap="pickDay">
        <block wx:if="{{!item.empty}}">
          <text>{{item.day}}</text>
          <text wx:if="{{item.hasRecord}}" class="dot" style="background:{{item.tint}}"></text>
        </block>
      </view>
    </view>
    <view class="cal-foot-row">
      <text class="cal-foot-tip">{{backfillTip}}</text>
      <button class="btn btn-sm btn-soft" bindtap="goToday">回到今天</button>
    </view>
  </view>

  <view wx:if="{{!hasRecords}}" class="card empty-card">
    <view class="empty-title">这天还没有记录</view>
    <view class="empty-desc">去「撰写」里选几个动作，保存一次训练，这里就会留下痕迹。</view>
  </view>

  <view wx:for="{{records}}" wx:key="id" wx:for-item="rec" wx:for-index="ri" class="card rec-card">
    <view class="rec-head">
      <text class="rec-time">{{rec.time}}</text>
      <text wx:if="{{rec.effortName}}" class="rec-eff" style="background:{{rec.effortColor}}">耗能 {{rec.effort}} · {{rec.effortName}}</text>
      <text class="del-btn" data-id="{{rec.id}}" bindtap="deleteRecord">删除</text>
    </view>

    <view wx:for="{{rec.groups}}" wx:for-item="grp" wx:key="key" class="rec-block {{grp.isKey ? 'is-key' : ''}}">
      <view class="rec-name-row">
        <text class="rec-name-btn" data-rec="{{rec.id}}" data-index="{{grp.firstIndex}}" bindtap="openSwap">{{grp.name}}</text>
        <text class="rec-part" style="background:{{grp.tint}}">{{grp.group}}</text>
        <text wx:if="{{grp.isKey}}" class="key-tag" data-rec="{{rec.id}}" data-index="{{grp.firstIndex}}" bindtap="clearRecordKey">关键重量<i>×</i></text>
        <text wx:else class="key-add" data-rec="{{rec.id}}" data-index="{{grp.firstIndex}}" bindtap="askRecordKey">＋关键重量</text>
      </view>
      <view class="rec-load-rows">
        <view wx:for="{{grp.rows}}" wx:for-item="row" wx:key="index" class="rec-load-row">
          <view class="rec-load-main">
            <text class="rec-load-val" data-rec="{{rec.id}}" data-index="{{row.index}}" bindtap="openLoadEdit">{{row.text}}</text>
            <text wx:if="{{row.note}}" class="rec-load-note">备注：{{row.note}}</text>
            <text class="rec-load-del" data-rec="{{rec.id}}" data-index="{{row.index}}" bindtap="deleteRecordItem">×</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 换动作弹窗 -->
<view class="mask dialog-mask" wx:if="{{swapOpen}}" bindtap="closeSwap">
  <view class="dialog" catchtap="noop">
    <view class="sheet-head">
      <text class="sheet-title">点一下换个动作</text>
      <text class="sheet-close" bindtap="closeSwap">×</text>
    </view>
    <input class="fld wide" placeholder="搜动作名或别名" value="{{swapSearch}}" bindinput="inputSwapSearch" confirm-type="search" />
    <view class="group-tabs">
      <view wx:for="{{swapTabs}}" wx:key="key" class="group-tab {{item.active ? 'on' : ''}}" data-key="{{item.key}}" bindtap="setSwapFilter">{{item.key}}</view>
    </view>
    <scroll-view class="sheet-body" scroll-y>
      <view wx:if="{{!swapItems.length}}" class="empty">没有匹配的动作。</view>
      <view class="picker-list">
        <view wx:for="{{swapItems}}" wx:key="id" class="picker-item" data-id="{{item.id}}" bindtap="pickSwap">
          <text class="picker-name">{{item.name}}</text>
          <text class="picker-group">{{item.group}}{{item.cardio ? ' · 有氧' : ''}}</text>
          <text class="picker-mark">换成</text>
        </view>
      </view>
    </scroll-view>
    <view class="sheet-foot">
      <button class="btn btn-ghost btn-block" bindtap="closeSwap">取消</button>
    </view>
  </view>
</view>

<!-- 改重量弹窗 -->
<view class="mask dialog-mask" wx:if="{{leOpen}}" bindtap="closeLoadEdit">
  <view class="dialog" catchtap="noop">
    <view class="sheet-head">
      <view class="sheet-title-wrap">
        <text class="sheet-title">改「{{leName}}」</text>
        <text class="sheet-sub">{{leCardio ? '规格、配速和附加都能改' : '重量、组数、每组次数和备注都能改'}}</text>
      </view>
      <text class="sheet-close" bindtap="closeLoadEdit">×</text>
    </view>
    <scroll-view class="sheet-body" scroll-y>
      <block wx:if="{{!leCardio}}">
        <view wx:for="{{leLoads}}" wx:for-item="load" wx:for-index="li" wx:key="index" class="le-block">
          <view class="le-line">
            <input class="fld" type="digit" placeholder="重量" value="{{load.weight}}" data-field="weight" data-block="{{li}}" bindinput="leInput" />
            <text class="each {{load.eachSide ? 'on' : ''}}" data-block="{{li}}" bindtap="leEachSide">各边</text>
          </view>
          <view class="le-line">
            <text class="le-label">组数</text>
            <text class="step" data-block="{{li}}" data-dir="-1" bindtap="leSetsStep">−</text>
            <text class="sets-num">{{load.sets}}</text>
            <text class="step" data-block="{{li}}" data-dir="1" bindtap="leSetsStep">＋</text>
          </view>
          <view class="le-line">
            <text class="le-label">每组次数</text>
            <text class="le-mode" data-block="{{li}}" bindtap="leRepMode">{{load.repMode === 'same' ? '统一 · 切换分别' : '分别 · 切换统一'}}</text>
          </view>
          <input wx:if="{{load.repMode === 'same'}}" class="fld wide" type="number" placeholder="次数" value="{{load.sameRep}}" data-field="sameRep" data-block="{{li}}" bindinput="leInput" />
          <view wx:else class="le-reps">
            <input wx:for="{{load.reps}}" wx:for-item="rep" wx:for-index="ri" wx:key="*this" class="fld rep" type="number" placeholder="{{ri + 1}}" value="{{rep}}" data-field="rep" data-block="{{li}}" data-rep="{{ri}}" bindinput="leInput" />
          </view>
        </view>
      </block>
      <block wx:else>
        <view wx:for="{{leLoads}}" wx:for-item="load" wx:for-index="li" wx:key="index" class="le-block">
          <view class="seg-head">
            <text class="seg-index">第 {{li + 1}} 段</text>
          </view>
          <input class="fld wide" type="text" placeholder="规格，如 5 km / 30 分钟" value="{{load.spec}}" data-field="spec" data-block="{{li}}" bindinput="leInput" />
          <view class="le-line">
            <input class="fld" type="digit" placeholder="配速" value="{{load.pace}}" data-field="pace" data-block="{{li}}" bindinput="leInput" />
            <view class="unit-tabs">
              <text wx:for="{{paceUnits}}" wx:for-item="u" wx:key="*this" class="unit {{load.paceUnit === u ? 'on' : ''}}" data-block="{{li}}" data-unit="{{u}}" bindtap="leUnit">{{u}}</text>
            </view>
          </view>
          <input class="fld wide" type="text" placeholder="附加，如 坡度 8" value="{{load.extra}}" data-field="extra" data-block="{{li}}" bindinput="leInput" />
        </view>
      </block>
      <input class="fld wide le-note" type="text" placeholder="备注：可以不填，比如状态、感受" value="{{leNote}}" bindinput="leNoteInput" />
    </scroll-view>
    <view class="sheet-foot">
      <button class="btn btn-ghost" bindtap="closeLoadEdit">取消</button>
      <button class="btn btn-main" bindtap="saveLoadEdit">保存改动</button>
    </view>
  </view>
</view>
