.trend-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.trend-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.trend-name {
  color: var(--name-ink);
  font-size: 30rpx;
  font-weight: 900;
}

.trend-count {
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 700;
}

.best-row {
  display: flex;
  gap: 12rpx;
  margin: 18rpx 0 6rpx;
}

.best {
  flex: 1 1 0;
  padding: 16rpx;
  background: var(--sky-soft);
  border: 1rpx solid var(--sky-line);
  border-radius: var(--r);
  text-align: center;
}

.best-num {
  display: block;
  color: var(--navy);
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.2;
}

.best-label {
  display: block;
  margin-top: 2rpx;
  color: var(--ink2);
  font-size: 21rpx;
  font-weight: 700;
}

.trend-tools {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.trend-canvas {
  display: block;
  width: 100%;
  height: 360rpx;
  margin-top: 18rpx;
}

.picker-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 76rpx;
  padding: 12rpx 18rpx;
  background: #fff;
  border: 1rpx solid var(--rule);
  border-radius: var(--r);
}

.picker-item.on {
  border-color: var(--sky-deep);
}

.picker-item:active {
  background: var(--sky-soft);
}

.picker-name {
  flex: 1 1 auto;
  min-width: 0;
  color: var(--name-ink);
  font-size: 26rpx;
  font-weight: 800;
}

.picker-group {
  color: var(--part-ink);
  font-size: 21rpx;
}

.picker-mark {
  flex: none;
  min-width: 60rpx;
  color: var(--navy);
  font-size: 22rpx;
  font-weight: 800;
  text-align: right;
}
