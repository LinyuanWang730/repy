<view class="page-wrap">

  <view class="card">
    <view class="card-head">
      <text class="sec-num">↗</text>
      <view class="card-title">
        <text class="t">重量趋势</text>
        <text class="d">每次记录里最重的那一组，折线连起来看走势</text>
      </view>
      <button class="btn btn-sm btn-soft" bindtap="openPicker">添加动作</button>
    </view>
    <view wx:if="{{!tracked.length}}" class="empty">还没有追踪的动作，点右上角「添加动作」。</view>
    <view wx:elif="{{!hasRecords}}" class="empty">还没有带重量的记录，先去「撰写」保存几次训练。</view>
  </view>

  <view wx:for="{{tracked}}" wx:for-item="tr" wx:key="id" class="card trend-card">
    <view class="trend-head">
      <view class="trend-title">
        <text class="trend-name">{{tr.name}}</text>
        <text class="chip">{{tr.group}}</text>
      </view>
      <view class="trend-tools">
        <text class="trend-count">{{tr.count}} 次</text>
        <text class="del-btn" data-id="{{tr.id}}" bindtap="removeTracked">删除</text>
      </view>
    </view>
    <view class="best-row">
      <view class="best">
        <text class="best-num">{{tr.best}}</text>
        <text class="best-label">最重</text>
      </view>
      <view class="best">
        <text class="best-num">{{tr.latest}}</text>
        <text class="best-label">最近一次</text>
      </view>
    </view>
    <canvas wx:if="{{tr.points.length}}" type="2d" id="chart-{{tr.id}}" class="trend-canvas"></canvas>
    <view wx:else class="empty">这个动作还没记过重量。</view>
  </view>
</view>

<!-- 添加追踪动作 -->
<view class="mask dialog-mask" wx:if="{{pickerOpen}}" bindtap="closePicker">
  <view class="dialog" catchtap="noop">
    <view class="sheet-head">
      <text class="sheet-title">添加动作（{{pickerCount}}/4）</text>
      <text class="sheet-close" bindtap="closePicker">×</text>
    </view>
    <view class="sheet-body">
      <view class="picker-list">
        <view wx:for="{{pickerItems}}" wx:key="id" class="picker-item {{item.picked ? 'on' : ''}}" style="background:{{item.picked ? item.tint : '#fff'}}" data-id="{{item.id}}" bindtap="togglePick">
          <text class="picker-name">{{item.name}}</text>
          <text class="picker-group">{{item.group}}</text>
          <text class="picker-mark">{{item.picked ? '已选' : '＋'}}</text>
        </view>
      </view>
    </view>
    <view class="sheet-foot">
      <button class="btn btn-ghost" bindtap="closePicker">取消</button>
      <button class="btn btn-main" bindtap="savePicker">就追这些</button>
    </view>
  </view>
</view>
